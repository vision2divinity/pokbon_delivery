# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# 3001, not 3000: something on this machine already listens on 3000.
PORT=3001

# Postgres. Host port 5435 — 5432 and 5433 are native Postgres installs and
# 5434 is AutoRescue's container. See docker-compose.yml.
DATABASE_URL=postgresql://pokbon:pokbon@localhost:5435/pokbon_delivery?schema=public

# Signs rider access tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-at-least-32-random-characters-please

# Public base of this API, for photo URLs and the tracking page.
PUBLIC_BASE_URL=http://localhost:3001

# Proxy hops in front of the API (0 = direct). Gates x-forwarded-for trust for
# the OTP per-IP rate limit. Set 1 behind one nginx/Cloudflare layer.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# The WordPress admin plugin — the ONLY thing this API talks to for money,
# SMS, push and settings. See PRD § 1a.
# ---------------------------------------------------------------------------

# 'console'  — log every outbound call instead of making it, and answer payment
#              prompts with a fake pending intent. No WordPress needed. The dev
#              outbox at GET /dev/outbox shows what would have been sent.
# 'live'     — call the plugin for real. Requires the two values below.
PLUGIN_MODE=console

# Base of the marketplace's REST namespace, e.g. https://pokbongroup.com/wp-json/pokbon/v1
PLUGIN_BASE_URL=http://localhost:8080/wp-json/pokbon/v1

# Shared secret, also stored in the plugin's secret vault. Signs both directions:
#   X-Pokbon-Delivery-Signature  = HMAC-SHA256(rawBody), hex
#   X-Pokbon-Delivery-Timestamp  = unix seconds, rejected if older than 5 minutes
#   X-Pokbon-Delivery-Event-Id   = UUID per event, replay-rejected
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLUGIN_SHARED_SECRET=change-me-64-hex-characters-shared-with-the-wordpress-plugin

# Pull zones, prices and settings from the plugin when the API boots.
# Leave false in console mode; the seed script fills the cache instead.
PLUGIN_SYNC_ON_BOOT=false

# ---------------------------------------------------------------------------
# OTP rate limits. Defaults are production values; raise only in a dev .env.
# ---------------------------------------------------------------------------
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_MIN_SECONDS_BETWEEN=30
